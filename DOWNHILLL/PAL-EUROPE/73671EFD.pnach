gametitle=Downhill Domination (Europe) [SLES-52202] [73671EFD]
comment=DOWNHILLL cheat pack - AetherSX2 / PCSX2
comment=Serial SLES-52202 | CRC 73671EFD | Region PAL-E
comment=Sumber: GameHacking.org (Code Master, MadCatz, Codejunkies), CheatDevicePS2, PCSX2 Wiki
comment=Simpan sebagai 73671EFD.pnach di folder cheats
comment=Mastercode tidak diperlukan di pnach
comment=Kode raw PAL resmi dari Codejunkies
comment=Unlock item PAL memakai kode tombol in-game

[01 - UANG, POWER & SKOR]
// Kode raw PAL yang terverifikasi. Tidak ada port paksa dari NTSC.
// Max Money - uang maksimal (bagian 1: lui at, 0x0100)
patch=1,EE,2013C850,extended,3C010100
// Max Money - uang maksimal (bagian 2: sw at, 0x2208(v1))
patch=1,EE,2013C854,extended,AC612208
// Max Power - power maksimal (100.0f)
patch=1,EE,202DC35C,extended,42C80000
// Max Score After 1 Jump - skor maksimal setelah 1 lompatan (bagian 1)
patch=1,EE,201EA328,extended,3C014960
// Max Score After 1 Jump - skor maksimal setelah 1 lompatan (bagian 2)
patch=1,EE,201EA338,extended,44811000

[02 - HYPER MODE (TOGGLE)]
// Tahan X+Up untuk hyper mode, X+Down untuk kembali normal. D-code mengecek input.
// Hyper Mode: tahan X + Up
patch=1,EE,D068E902,extended,0000BFEF
// Hyper Mode: set kecepatan hyper
patch=1,EE,2024DC04,extended,00000000
// Normal Mode: tahan X + Down
patch=1,EE,D068E902,extended,0000BFBF
// Normal Mode: kembalikan kecepatan normal
patch=1,EE,2024DC04,extended,0C09833C

[03 - CATATAN PAL]
// Versi PAL (SLES-52202) hanya punya 6 kode raw resmi.
// Untuk unlock semua item/rider di PAL, gunakan kode tombol in-game:
//   Unlock Code : Up, Triangle, Down, X, Left, Circle, Right, Square
//   Unlock All  : Down, Up, Up, Down, Down, Up, Up
// Kode tombol berlaku sama di USA dan PAL. Lihat KODE-TOMBOL.txt.
// 60Hz dan Y Fix ada di folder OPTIONAL.
